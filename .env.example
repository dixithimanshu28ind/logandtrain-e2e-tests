# Base URL the tests run against. Defaults to the local Next.js dev server
# if unset. Point this at https://www.logandtrain.com (the real site, which is
# what CI tests) for a production run.
BASE_URL=http://localhost:3000

# Same Supabase project gym-workout-logger uses (there is only one — no
# separate test/staging project exists). These are only needed to create
# and delete throwaway test users via the admin API, so tests never
# accumulate junk accounts. Get them from:
# Supabase Dashboard > Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY is highly privileged — never commit the real
# value, keep it only in your local .env (gitignored) and as a GitHub
# Actions secret.
SUPABASE_URL=https://cchbdhkkkzepcqsodfis.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
